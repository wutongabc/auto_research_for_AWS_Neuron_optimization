# Neuron Prefill Optimization — Environment Configuration
# AI-EDITABLE: This file can be modified during Phase 1 (params)

# === Model ===
MODEL_PATH="Alibaba-NLP/Tongyi-DeepResearch-30B-A3B"

# === Server ===
PORT=8100
HOST="0.0.0.0"

# === Neuron Compilation ===
NEURON_CC_FLAGS="--optlevel 1 --model-type transformer --enable-fast-loading-neuron-binaries"
NEURON_COMPILE_WORKERS=8

# === vLLM Serving Parameters ===
# Prefill chunk size (tokens processed per prefill step)
MAX_NUM_BATCHED_TOKENS=4096

# Maximum sequences in flight
MAX_NUM_SEQS=1

# Block size for KV cache
BLOCK_SIZE=64

# KV cache dtype (fp8 for memory efficiency)
KV_CACHE_DTYPE="auto"

# === Bucket Configuration ===
# Context length buckets for compilation (comma-separated)
# Fewer buckets = faster compile, but may waste compute on padding
CONTEXT_LENGTH_BUCKETS="4096"

# Decode context length buckets
DECODE_CONTEXT_LENGTH_BUCKETS="8192"

# === MoE Configuration ===
# Enable fused NKI MoE kernel
VLLM_NEURON_FUSED_MOE_NKI=1

# FP8 expert weights (halves weight DMA bandwidth for MoE)
VLLM_NEURON_FP8_EXPERT_WEIGHTS=0
VLLM_NEURON_FP8_ONLY=0

# === Scheduling ===
# Prefill scheduling policy
SCHEDULING_POLICY="fcfs"

# Enable chunked prefill
ENABLE_CHUNKED_PREFILL=1

# === Memory ===
# Fraction of HBM to use for KV cache
KV_BUDGET_CAP=0.05

# === Logprobs (required for correctness checking) ===
MAX_LOGPROBS=5

# === Debug / Profiling (disabled by default) ===
# NEURON_FRAMEWORK_DEBUG=1
# NEURON_PROFILE=1
